# Base URL of the FastAPI backend. Local dev points at the dev server;
# in production set this to the deployed backend (e.g. the Render URL).
# Vite inlines this at build time, so it must be present when running
# `npm run build` (the CI deploy workflow sets it).
VITE_API_BASE_URL=http://localhost:8000

# Password for the /personal private section.
# Set this to a strong secret before deploying.
VITE_PERSONAL_PASSWORD=password
